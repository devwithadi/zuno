NODE_ENV=development
PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27028
MONGODB_DB=zuno
DEMO_MODE=false
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
CLERK_SECRET_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:8081
# Set EDITOR_MODE=langchain and explicitly choose local or bedrock inference.
# Extractive mode keeps source text and headlines unchanged.
EDITOR_MODE=extractive
EDITOR_PROVIDER=local
LOCAL_MODEL_URL=
LOCAL_MODEL_NAME=

# Optional Amazon Bedrock Converse (billable): choose EDITOR_PROVIDER=bedrock.
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
AWS_BEARER_TOKEN_BEDROCK=
