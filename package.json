{
  "name": "zuno",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:app\"",
    "dev:api": "tsx watch services/api/main.ts",
    "dev:app": "npm run web --workspace @zuno/mobile",
    "worker": "tsx services/worker/main.ts",
    "worker:once": "tsx services/worker/main.ts --once",
    "enrich": "tsx scripts/enrich-feed.ts",
    "check:lines": "node scripts/check-lines.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run check:lines && npm run check:architecture && npm run typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "build:web": "npm run build:web --workspace @zuno/mobile",
    "check:architecture": "tsx scripts/check-architecture.ts"
  },
  "dependencies": {
    "@clerk/backend": "3.26.2",
    "@hono/node-server": "2.1.5",
    "@langchain/aws": "1.5.1",
    "@langchain/core": "1.3.1",
    "@langchain/openai": "1.7.0",
    "dotenv": "18.0.9",
    "fast-xml-parser": "5.11.2",
    "hono": "4.13.13",
    "mongodb": "7.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "concurrently": "10.0.6",
    "mongodb-memory-server": "11.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
